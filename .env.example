# Copy to .env to change settings. Everything here is optional.
# With no .env at all the app runs in mock mode (offline, free).

# Mock mode: true = offline mock provider, false = live Claude via the Agent SDK.
# Live mode needs no API key if Claude Code is already logged in on this machine
# (the SDK uses that login). Run `claude` once and /login if you haven't.
MOCK_MODE=true

# Models for live mode: sonnet / opus / haiku aliases or full model IDs.
GENERATOR_MODEL=sonnet
JUDGE_MODEL=sonnet
DEEP_JUDGE_MODEL=opus

# Parallel LLM calls
GENERATION_CONCURRENCY=6
JUDGING_CONCURRENCY=6

# Server
PORT=8787
DATA_DIR=./data
